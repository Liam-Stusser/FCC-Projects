body {
  font-family: Arial, sans-serif;
  background-color: #0a0a1a; 
  color: #ecf0f1; 
  margin: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.container {
  background: #34495e; 
  padding: 20px 30px;
  border-radius: 10px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  text-align: center;
  max-width: 400px;
  width: 100%;
}

h1 {
  margin-bottom: 20px;
  font-size: 1.8em;
  color: #ecf0f1; 
}

input {
  width: 95%;
  padding: 11px;
  margin-bottom: 15px;
  border: none;
  border-radius: 5px;
  font-size: 16px;
  background-color: #2c3e50; 
  color: #ecf0f1; 
}

input::placeholder {
  color: #95a5a6; 
}

.buttons {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

button {
  flex: 1;
  padding: 12px;
  font-size: 16px;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

#check-btn {
  background-color: #27ae60; 
  color: white;
}

#check-btn:hover {
  background-color: #2ecc71; 
}

#clear-btn {
  background-color: #c0392b; 
  color: white;
}

#clear-btn:hover {
  background-color: #e74c3c; 
}

#results-div {
  margin-top: 20px;
  font-size: 18px;
  font-weight: bold;
  color: #ecf0f1; 
}

#results-div.valid {
  color: #2ecc71; 
}

#results-div.invalid {
  color: #e74c3c; 
}
